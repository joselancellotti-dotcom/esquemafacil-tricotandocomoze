# Mercado Pago Integration
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token_here

# YouTube API Integration (Creator side)
# The API Key or OAuth Token used by the creator to check member lists
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
# Optional: comma-separated list of allowed membership levels (e.g. "Tricoteiro VIP, Nível 2")
ALLOWED_YOUTUBE_LEVELS=your_allowed_membership_level_here
